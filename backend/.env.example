# Salin file ini menjadi .env lalu sesuaikan isinya:
#   cp .env.example .env

# ==================================================================
# UMUM
# ==================================================================
SECRET_KEY=ubah-dengan-string-acak-yang-panjang-dan-rahasia
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./notasi.db

MAX_UPLOAD_MB=500
MAX_IMAGE_MB=15

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Administrator

# ==================================================================
# PROVIDER AI — pilih independen untuk Speech-to-Text (STT) dan
# peringkasan (LLM). Tidak perlu mengubah kode apa pun, cukup ganti
# nilai di bawah ini lalu jalankan ulang server.
#
#   STT_PROVIDER : demo (default, gratis, data contoh)
#                  openai (berbayar, butuh OPENAI_API_KEY)
#                  local  (faster-whisper, GRATIS, jalan di server sendiri)
#
#   LLM_PROVIDER : demo (default, gratis, data contoh)
#                  openai (berbayar, butuh OPENAI_API_KEY)
#                  ollama (Llama3/Mistral via Ollama, GRATIS, jalan di server sendiri)
# ==================================================================
STT_PROVIDER=local
LLM_PROVIDER=ollama

# --- Wajib diisi hanya jika STT_PROVIDER atau LLM_PROVIDER = openai ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini

# --- Dipakai hanya jika STT_PROVIDER = local (faster-whisper) ---
# ==== SETELAN KECEPATAN (baca README bagian "Mempercepat Pemrosesan") ====
# Ukuran model: tiny | base | small | medium | large-v3
#   small  = seimbang, DEFAULT (±3-5x lebih cepat dari medium)
#   base   = lebih cepat lagi, akurasi turun (cocok untuk audio jernih)
#   medium = akurasi lebih baik tapi berat di CPU
WHISPER_LOCAL_MODEL=small
# cpu | cuda (pakai "cuda" bila ada GPU NVIDIA -> 10-30x lebih cepat)
WHISPER_LOCAL_DEVICE=cpu
# Kosongkan = otomatis (int8 untuk CPU, float16 untuk GPU)
WHISPER_COMPUTE_TYPE=
# 1 = greedy decoding, 2-3x lebih cepat dari default 5. Naikkan ke 5 bila
# akurasi lebih penting daripada kecepatan.
WHISPER_BEAM_SIZE=1
# Kosong = deteksi bahasa otomatis (mendukung rapat bilingual Indonesia/
# Inggris). Isi "id" atau "en" untuk memaksa satu bahasa.
WHISPER_LANGUAGE=
# true = normalisasi loudness (ffmpeg) sebelum STT, membantu rekaman dari
# mic yang jauh/pelan dari sumber suara. Butuh ffmpeg; kalau tidak ada,
# otomatis dilewati.
WHISPER_AUDIO_NORMALIZE=true
# true = potong bagian hening/jeda sebelum transkripsi. Pada rekaman rapat
# nyata biasanya memangkas 30-60% waktu kerja.
WHISPER_VAD=true
# 0 = pakai semua inti CPU yang tersedia (disarankan)
WHISPER_CPU_THREADS=0
# Batched inference (butuh faster-whisper >= 1.1): 2-4x lebih cepat. 0 = mati.
WHISPER_BATCH_SIZE=8
# Muat model saat server start supaya rapat pertama tidak menunggu 1-3 menit
WHISPER_PRELOAD=true

# --- CHUNKING PARALEL untuk audio panjang (mis. rapat 4-5 jam) ---
# Butuh ffmpeg terpasang di PATH server (https://ffmpeg.org). Bila ffmpeg
# tidak ditemukan, otomatis kembali ke mode biasa (satu proses) - aplikasi
# tetap berjalan normal, hanya tidak lebih cepat untuk audio panjang.
WHISPER_CHUNK_ENABLED=true
# Audio di bawah durasi ini (menit) tidak dipecah - overhead tidak sepadan
WHISPER_CHUNK_THRESHOLD_MINUTES=15
# Panjang tiap potongan (menit)
WHISPER_CHUNK_MINUTES=10
# Jumlah proses paralel - cocokkan dengan jumlah CORE FISIK server (bukan
# logical/hyperthread), karena tiap proses memuat salinan model sendiri ke
# RAM. Contoh: server 2 core/8GB RAM -> 2. Server 8 core/32GB RAM -> 4-6.
WHISPER_CHUNK_WORKERS=2

# --- Dipakai hanya jika LLM_PROVIDER = ollama ---
# Pastikan aplikasi Ollama sudah terpasang & modelnya sudah diunduh:
#   ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# Default: model ringan (~2GB), aman untuk server kecil (~8GB RAM).
# Alternatif lebih besar & lebih akurat (ollama pull llama3, ~4.7GB) - HANYA
# disarankan bila server punya >= 16GB RAM, karena model 8B + OLLAMA_NUM_CTX
# besar sekaligus mudah membuat Ollama kehabisan memori di server kecil:
#   OLLAMA_MODEL=llama3
OLLAMA_MODEL=llama3.2:3b
# Model 8B di CPU bisa butuh lebih dari 300 dtk untuk transkrip panjang.
# Naikkan bila proses sering gagal dengan pesan "Read timed out" di Arsip.
OLLAMA_TIMEOUT_SECONDS=300
# 0 = paksa CPU-only (default aman). Di sebagian mesin, offload otomatis ke
# GPU membuat Ollama menghasilkan JSON rusak/terpotong (kata dobel, output
# kosong) - gejala driver GPU, bukan model. Kalau GPU Anda sudah terbukti
# beres, boleh dinaikkan (mis. 999) untuk mempercepat.
OLLAMA_NUM_GPU=0
# Penyebab PALING UMUM ringkasan AI "tidak sesuai": default context window
# Ollama (2048 token) memotong diam-diam sebagian besar transkrip rapat asli
# sebelum sampai ke model. 4096 token cukup aman untuk server RAM kecil dan
# menutupi rapat ~30-45 menit; naikkan (mis. 8192) kalau RAM longgar & rapat
# sering lebih panjang, turunkan kalau Ollama sering gagal/macet karena OOM.
OLLAMA_NUM_CTX=4096

# ==================================================================
# SPEAKER DIARIZATION (opsional, pyannote.audio) - hanya alur "Rapat"
# Butuh: pip install -r requirements-diarization.txt (PyTorch + pyannote,
# ~2-3GB) DAN token HuggingFace (akun gratis, terima lisensi model di
# huggingface.co/pyannote/speaker-diarization-3.1 dan
# huggingface.co/pyannote/segmentation-3.0, lalu buat token di
# huggingface.co/settings/tokens). Kalau paket/token tidak ada, diarization
# otomatis nonaktif (log peringatan) - transkripsi utama tetap jalan normal.
# ==================================================================
DIARIZATION_ENABLED=false
HUGGINGFACE_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# Di atas durasi ini (menit), diarization dilewati (CPU tanpa GPU bisa
# sangat lambat) - transkripsi utama tetap lanjut.
DIARIZATION_MAX_AUDIO_MINUTES=60

# ==================================================================
# WHATSAPP CLOUD API (Meta, resmi & gratis) - kirim undangan/notula rapat
# otomatis ke WhatsApp pegawai, tanpa perlu klik "Kirim" manual satu-satu.
# Kosongkan semua untuk nonaktifkan fitur ini (tombol "Kirim Otomatis" tidak
# akan muncul, tapi tautan wa.me manual di tombol "Kirim ke Semua" tetap
# jalan tanpa kredensial apa pun).
#
# Cara mendapatkan (gratis, ~10 menit):
#   1. Buka developers.facebook.com > My Apps > Create App > pilih use case
#      "Other" > tipe "Business".
#   2. Di dashboard app, tambahkan produk "WhatsApp".
#   3. Halaman "API Setup" akan menampilkan nomor uji coba GRATIS dari Meta,
#      Temporary Access Token (berlaku 24 jam - untuk token permanen, buat
#      System User di Business Settings > System Users), dan Phone Number
#      ID - salin ke WHATSAPP_ACCESS_TOKEN & WHATSAPP_PHONE_NUMBER_ID di bawah.
#   4. Di halaman API Setup juga ada "To" - tambahkan nomor WA yang mau
#      dijadikan penerima uji coba (maks 5 nomor, mode belum verifikasi
#      bisnis) - klik "Manage phone number list" lalu verifikasi nomor lewat
#      kode OTP yang dikirim ke nomor itu.
#   5. Buat template pesan: WhatsApp Manager > Message Templates > Create
#      Template, kategori "Utility", lalu buat 2 template PERSIS seperti ini
#      (nama & isi harus sama persis, kode ini mengirim variabel berurutan):
#
#      Nama: notasi_undangan   | Bahasa: Indonesian
#      Body:
#        Undangan Rapat: {{1}}
#        Yth. {{2}},
#
#        Anda diundang menghadiri rapat berikut:
#        Tanggal: {{3}}
#        Waktu: {{4}}
#        Tempat: {{5}}
#        Agenda: {{6}}
#
#        Mohon kehadirannya. Terima kasih.
#        {{7}}
#
#      Nama: notasi_notula   | Bahasa: Indonesian
#      Body:
#        Notula Rapat: {{1}}
#        Yth. {{2}},
#
#        Berikut ringkasan notula rapat tanggal {{3}}:
#
#        {{4}}
#
#        Dokumen lengkap tersedia di aplikasi NOTASI. Terima kasih.
#        {{5}}
#
#      Template biasanya disetujui dalam beberapa menit (kadang sampai
#      24 jam). Sebelum disetujui, pengiriman akan gagal dengan pesan error
#      dari Meta yang jelas (ditampilkan di UI, per penerima).
#   6. Isi WHATSAPP_TEMPLATE_LANG sesuai bahasa yang dipilih saat membuat
#      template (mis. "id" untuk Indonesian, "en_US" untuk English US).
# ==================================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_UNDANGAN=notasi_undangan
WHATSAPP_TEMPLATE_NOTULA=notasi_notula
WHATSAPP_TEMPLATE_LANG=id

# ------------------------------------------------------------------
# WHATSAPP via whacenter (gateway TIDAK RESMI - HANYA UNTUK PERCOBAAN)
# ------------------------------------------------------------------
# Dipakai tombol "Blast Undangan via WhatsApp" (teks polos) di halaman Rapat.
# whacenter.my.id menjembatani WhatsApp lewat HP yang sudah dipasangi bot -
# BUKAN jalur resmi Meta, melanggar ToS WhatsApp & berisiko nomor diblokir.
# Pakai hanya untuk uji coba internal. Kosongkan WHACENTER_DEVICE_ID untuk
# menonaktifkan tombol blast (teks tetap bisa disalin manual dari UI).
#   1. Daftar & pindai QR di https://whacenter.my.id memakai HP uji coba.
#   2. Salin Device ID perangkat itu ke WHACENTER_DEVICE_ID di bawah.
WHACENTER_API_URL=https://app.whacenter.com/api/send
WHACENTER_DEVICE_ID=

