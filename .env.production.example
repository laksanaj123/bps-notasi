# Template env untuk deployment VPS via docker-compose.
# Salin ke .env di root repo (SEJAJAR dengan docker-compose.yml, BUKAN di
# backend/.env), lalu isi nilai di bawah ini sebelum `docker compose up`.
#   cp .env.production.example .env

# ==================================================================
# DOMAIN & TLS (dibaca oleh Caddyfile untuk sertifikat otomatis)
# ==================================================================
DOMAIN=notasi.contoh-instansi.go.id

# ==================================================================
# UMUM
# ==================================================================
# WAJIB diganti - generate dengan: openssl rand -hex 32
SECRET_KEY=ganti-dengan-hasil-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ditaruh di volume ./data/db (lihat docker-compose.yml), bukan di dalam
# image, supaya data tidak hilang saat container di-rebuild.
DATABASE_URL=sqlite:////srv/backend/data/notasi.db

MAX_UPLOAD_MB=500
MAX_IMAGE_MB=15

# WAJIB ganti password default ini setelah login pertama kali.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ganti-password-default-ini

# Batasi CORS ke domain sendiri saat produksi (lihat README §10).
# Pisahkan dengan koma jika lebih dari satu origin.
CORS_ORIGINS=https://notasi.contoh-instansi.go.id

# ==================================================================
# PROVIDER AI - mode lokal (faster-whisper + Ollama), tanpa API key
# ==================================================================
STT_PROVIDER=local
LLM_PROVIDER=ollama

WHISPER_LOCAL_MODEL=small
WHISPER_LOCAL_DEVICE=cpu
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true
WHISPER_CPU_THREADS=0
WHISPER_BATCH_SIZE=8
WHISPER_PRELOAD=true

WHISPER_CHUNK_ENABLED=true
WHISPER_CHUNK_THRESHOLD_MINUTES=15
WHISPER_CHUNK_MINUTES=10
# Cocokkan dengan jumlah core fisik VPS (mis. VPS 4 vCPU -> 2-3).
WHISPER_CHUNK_WORKERS=2

# "ollama" adalah nama service di docker-compose.yml, BUKAN localhost.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_GPU=0

# ==================================================================
# IDENTITAS SATUAN KERJA (kop surat dokumen notulensi)
# ==================================================================
UNIT_KERJA_DEFAULT=BPS Kabupaten Sanggau
NAMA_INSTANSI=BADAN PUSAT STATISTIK KABUPATEN SANGGAU
ALAMAT_INSTANSI=Jalan Sutan Syahrir Nomor 52 A, Sanggau 78512 ; Telepon : (+62-564) 21844 ; Laman https://sanggaukab.bps.go.id/ ; Post-el bps6105@bps.go.id
